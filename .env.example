# Virtual Power Plant API configuration.
# Copy to .env (read from the working directory) and adjust. Real environment
# variables override this file. Every setting is documented, with its
# default, in docs/configuration.md. Commented-out lines show the default or
# an example value.

# =============================================================================
# Core
# =============================================================================
VPP_ENV=development
VPP_DEBUG=false
VPP_LOG_LEVEL=INFO
# JSON logs; unset = JSON only when VPP_ENV=production.
# VPP_LOG_JSON=false
# VPP_ACCESS_LOG_ENABLED=true

# =============================================================================
# API server
# =============================================================================
# Defaults for `vpp serve` (its --host/--port/--workers override them; plain
# uvicorn takes its own flags). With more than one worker, singleton work
# runs on DB-lease holders (docs/architecture.md#process-model); set
# VPP_API_WORKERS to the real worker count even when starting uvicorn
# yourself. OCPP requires 1.
# VPP_API_HOST=0.0.0.0
# VPP_API_PORT=8000
# VPP_API_WORKERS=1
# VPP_CLUSTER_LEASE_TTL_SECONDS=15
# VPP_CLUSTER_CALL_TIMEOUT_SECONDS=10
# VPP_CLUSTER_POLL_INTERVAL_SECONDS=0.25
VPP_CORS_ORIGINS=["http://localhost:3000"]

# =============================================================================
# Security
# =============================================================================
# REQUIRED outside local development. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VPP_SECRET_KEY=change-me-to-a-real-secret-key
VPP_JWT_ALGORITHM=HS256
VPP_JWT_EXPIRE_MINUTES=60
# Not currently read (the API key header is always X-API-Key):
# VPP_API_KEY_HEADER=X-API-Key
# Per-client-IP rate limit (in-process). All web-console traffic comes from
# the Next.js server's IP, so raise this when several people use the console.
VPP_RATE_LIMIT_ENABLED=true
VPP_RATE_LIMIT_REQUESTS_PER_MINUTE=120
# WebSocket (/api/v1/ws, /ws): refuse unauthenticated sockets (close 1008).
VPP_WS_AUTH_REQUIRED=true
# How long a POST /api/v1/ws/token token may be used to open a socket.
VPP_WS_TOKEN_EXPIRE_SECONDS=60

# =============================================================================
# Database
# =============================================================================
# SQLite (development):
VPP_DATABASE_URL=sqlite+aiosqlite:///./vpp.db
# PostgreSQL (production; migrations additionally need psycopg2):
# VPP_DATABASE_URL=postgresql+asyncpg://vpp:password@localhost:5432/vpp
# false: create tables with create_all on startup (dev). true: run
# `alembic upgrade head` on startup. In production prefer `vpp migrate`.
VPP_USE_ALEMBIC=false

# =============================================================================
# Monitoring and alerts
# =============================================================================
VPP_METRICS_ENABLED=true
# Not currently read (metric names are fixed to vpp_*):
# VPP_METRICS_PREFIX=vpp
# When set, GET /metrics requires "Authorization: Bearer <token>".
# VPP_METRICS_BEARER_TOKEN=
VPP_ALERTS_ENABLED=true
VPP_ALERTS_SEED_DEFAULT_RULES=true
# Outbound webhook for fired alerts (HMAC-SHA256 signed when a secret is set).
# VPP_ALERT_WEBHOOK_URL=https://hooks.example.com/vpp-alerts
# VPP_ALERT_WEBHOOK_SECRET=
# VPP_ALERT_WEBHOOK_TIMEOUT_SECONDS=5.0
# VPP_ALERT_WEBHOOK_MAX_RETRIES=3

# =============================================================================
# Battery degradation (state-of-health updater)
# =============================================================================
VPP_DEGRADATION_UPDATER_ENABLED=true
VPP_DEGRADATION_UPDATER_INTERVAL_MINUTES=60

# =============================================================================
# MQTT battery telemetry ingestion
# =============================================================================
# Disabled by default -- dials out to an external broker on startup.
VPP_MQTT_INGESTION_ENABLED=false
VPP_MQTT_BROKER_HOST=localhost
VPP_MQTT_BROKER_PORT=1883
VPP_MQTT_TOPIC_PREFIX=vpp/#
# VPP_MQTT_USERNAME=
# VPP_MQTT_PASSWORD=

# =============================================================================
# Modbus inverter/meter telemetry ingestion
# =============================================================================
# Disabled by default -- dials out to physical devices. Per-device
# connection config lives on each resource's own `metadata["modbus"]`, not
# here -- see src/vpp/protocols/modbus_ingestion.py's module docstring.
VPP_MODBUS_INGESTION_ENABLED=false

# =============================================================================
# Grid / EV protocol endpoints (docs/protocols.md)
# =============================================================================
# Every adapter below is disabled by default. Adapters without a configured
# real endpoint report status "simulated" (never "connected") in
# GET /api/v1/protocols, so dashboards can't mistake them for live control.

# --- OCPP 1.6-J Central System (EV chargers) ---
# Charge points connect to ws(s)://<api-host>/ocpp/{charge_point_id} with the
# "ocpp1.6" subprotocol. Terminate TLS (wss://) at your reverse proxy.
VPP_OCPP_ENABLED=false
# VPP_OCPP_HEARTBEAT_INTERVAL_S=300
# VPP_OCPP_CALL_TIMEOUT_S=30
# Accept BootNotification from charge points not seen before:
# VPP_OCPP_AUTO_ACCEPT_BOOT=true
# Empty = any charge point id may connect:
# VPP_OCPP_ALLOWED_CHARGE_POINTS=["CP-001","CP-002"]
# Security Profile 1 (HTTP Basic, username = charge point id):
# VPP_OCPP_BASIC_AUTH_PASSWORD=change-me
# Unset = every idTag is accepted:
# VPP_OCPP_AUTHORIZED_ID_TAGS=["RFID-1234"]
# VPP_OCPP_REMOTE_ID_TAG=VPP
# Max ChargingSchedulePeriods per SetChargingProfile:
# VPP_V2G_MAX_PROFILE_PERIODS=48

# --- OpenADR 2.0b VEN (demand response, HTTP pull) ---
VPP_OPENADR_ENABLED=false
# VPP_OPENADR_VTN_URL=https://vtn.example.com/OpenADR2/Simple/2.0b
# VPP_OPENADR_VEN_NAME=vpp-ven
# VEN id is normally assigned by the VTN at registration:
# VPP_OPENADR_VEN_ID=ven-1234
# Leave unset to use the VTN-requested poll frequency:
# VPP_OPENADR_POLL_INTERVAL_S=10
# VPP_OPENADR_AUTO_OPT_IN=true
# VPP_OPENADR_TIMEOUT_S=10
# VPP_OPENADR_VERIFY_TLS=true
# VPP_OPENADR_CA_PATH=/etc/vpp/certs/vtn-ca.pem
# VPP_OPENADR_CERT_PATH=/etc/vpp/certs/ven.crt
# VPP_OPENADR_KEY_PATH=/etc/vpp/certs/ven.key

# --- IEEE 2030.5 (SEP 2.0) DER client, mutual TLS ---
VPP_IEEE2030_5_ENABLED=false
# VPP_IEEE2030_5_SERVER_URL=https://utility.example.com:8443
# VPP_IEEE2030_5_DCAP_PATH=/dcap
# Leave unset to derive the LFDI from the client certificate:
# VPP_IEEE2030_5_LFDI=3E4F45AB31EDFE5B67E343E5E4562E31984E23E5
# Leave unset to follow the server's pollRate:
# VPP_IEEE2030_5_POLL_INTERVAL_S=300
# VPP_IEEE2030_5_TIMEOUT_S=10
# VPP_IEEE2030_5_VERIFY_TLS=true
# VPP_IEEE2030_5_CA_PATH=/etc/vpp/certs/2030-5-ca.pem
# VPP_IEEE2030_5_CERT_PATH=/etc/vpp/certs/device.crt
# VPP_IEEE2030_5_KEY_PATH=/etc/vpp/certs/device.key
# VPP_IEEE2030_5_TLS_CIPHERS=ECDHE-ECDSA-AES128-CCM8

# =============================================================================
# Demand-response orchestrator (OpenADR / IEEE 2030.5 -> fleet dispatch)
# =============================================================================
# OFF by default: signals are recorded and shown, nothing is dispatched.
VPP_DR_AUTO_RESPONSE_ENABLED=false
# VPP_DR_TICK_INTERVAL_S=5.0
# VPP_DR_REDISPATCH_INTERVAL_S=900.0
# Hard caps (kW) applied to every DR target, last:
# VPP_DR_MAX_EXPORT_KW=500
# VPP_DR_MAX_IMPORT_KW=500
# OpenADR SIMPLE level 0..3 -> fraction of fleet export capability:
# VPP_DR_SIMPLE_LEVEL_FRACTIONS=[0.0, 0.5, 0.75, 1.0]
# VPP_DR_MIN_OPT_IN_FRACTION=0.5
# VPP_DR_INCLUDE_V2G=true
# setMaxW (W) for IEEE 2030.5 percentage controls; unset = fleet capability:
# VPP_DR_IEEE2030_5_SET_MAX_W=250000

# =============================================================================
# Simulated trading venue
# =============================================================================
# Advances simulated prices and matches resting orders; nothing leaves the
# process.
VPP_TRADING_MARKET_DATA_ENABLED=true
VPP_TRADING_MARKET_DATA_INTERVAL_SECONDS=5.0

# =============================================================================
# Platform configuration document
# =============================================================================
# Not currently read by the API; the live configuration is applied with
# PUT /api/v1/config and stored in the database.
# VPP_CONFIG_PATH=configs/advanced_vpp_config.yaml
VPP_DEFAULT_TIMEZONE=UTC

# =============================================================================
# Third-party keys (not VPP_-prefixed)
# =============================================================================
# OpenEI Utility Rate Database key for POST /api/v1/tariffs/import-urdb.
# OPENEI_API_KEY=
