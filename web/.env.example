# Public base URL of the FastAPI backend (used by server-side fetches)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Cookie name used to store the JWT (httpOnly, server-only)
AUTH_COOKIE_NAME=vpp_session

# Optional: override the upstream URL the Next.js server uses to reach the API
# when the public URL would not resolve from inside Docker.
API_BASE_URL=http://localhost:8000
