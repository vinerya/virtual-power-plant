# VPP web console — copy to .env.local and adjust.
# NEXT_PUBLIC_* variables are inlined at BUILD time (`next build`/`next dev`);
# the others are read by the Next.js server at runtime.

# --- Backend (FastAPI) -------------------------------------------------------
# Base URL the Next.js *server* uses to reach FastAPI (route handlers and the
# /api/proxy/* pass-through). May be an internal address, e.g. http://api:8000
# inside docker-compose.
API_BASE_URL=http://localhost:8000
# Legacy fallback used only when API_BASE_URL is unset.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Name of the httpOnly cookie holding the session JWT. Must match between the
# middleware, route handlers and proxy (default: vpp_session).
# AUTH_COOKIE_NAME=vpp_session

# --- Live updates (WebSocket) ------------------------------------------------
# Next.js cannot proxy WebSocket upgrades, so the BROWSER connects to FastAPI
# directly at <backend>/api/v1/ws, authenticating with a short-lived token
# minted via /api/auth/ws-token. The URL the browser dials is resolved as:
#   1. WS_PUBLIC_URL        (runtime; preferred for container deployments)
#   2. NEXT_PUBLIC_WS_URL   (build time)
#   3. API_BASE_URL with http(s) -> ws(s) and /api/v1/ws appended
# Set one of the first two whenever API_BASE_URL is not reachable from the
# browser. Behind TLS use wss://. The backend must be reachable on that host.
# WS_PUBLIC_URL=wss://vpp.example.com/api/v1/ws
# NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

# --- Demo / mock mode --------------------------------------------------------
# When 1, API calls that fail (404, 5xx, backend unreachable) fall back to
# bundled demo data for the customer portal, alerts and sites pages, and the
# WebSocket client stays disabled. Leave unset in real deployments: missing
# or broken endpoints must surface as errors, not as fake data.
# NEXT_PUBLIC_USE_MOCKS=1

# --- Playwright (tests/*.spec.ts) ---------------------------------------------
# E2E_BASE_URL=http://localhost:3000       # test an already-running app
# E2E_PORT=3000                            # port for the auto-started server
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/path/to/chrome  # use a preinstalled Chromium
